# Production Environment Variables Template for Green Uni Mind Backend
# DO NOT COMMIT THIS FILE WITH REAL SECRETS
# Copy this template and set actual values in your hosting platform

NODE_ENV=production
PORT=5000

# Database - Set this in your hosting platform environment variables
DATABASE_URL=your_mongodb_connection_string_here

# Security
BCRYPT_SALT_ROUNDS=12

# Cloudinary Configuration - Set these in your hosting platform
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Configuration - Set these in your hosting platform
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=365d

# Production URLs - CRITICAL FOR CORS AND OAUTH
# Primary production frontend domain
FRONTEND_URL=https://www.greenunimind.com
# Alternative frontend domains (comma-separated)
FRONTEND_URLS=https://www.greenunimind.com,https://tan-stork-651174.hostingersite.com
BACKEND_URL=https://green-uni-mind-backend-oxpo.onrender.com

# Password Reset Link - Will be dynamically determined based on origin
RESET_PASS_UI_LINK=https://www.greenunimind.com/reset-password

# Admin Configuration - Set this in your hosting platform
SUPER_ADMIN_PASSWORD=your_super_admin_password

# Teacher Invite Link
INVITE_TEACHER_LINK=https://green-uni-mind-backend-oxpo.onrender.com/api/v1/teacher-invite

# Stripe Configuration - Set these in your hosting platform
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_CONNECT_WEBHOOK_SECRET=your_stripe_connect_webhook_secret
STRIPE_WEBHOOK_ENDPOINT_URL=https://green-uni-mind-backend-oxpo.onrender.com/api/v1/payments/webhook
MOTHER_STRIPE_ACCOUNT_ID=your_stripe_account_id

# AI Configuration - Set this in your hosting platform
GEMINI_API_KEY=your_gemini_api_key

# Keep-alive service configuration
KEEP_ALIVE_ENABLED=true

# Email Configuration - Set these in your hosting platform
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# OAuth Configuration - CRITICAL: Must match Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Backend OAuth callback URL (for Google Cloud Console)
GOOGLE_REDIRECT_URI=https://green-uni-mind-backend-oxpo.onrender.com/api/v1/oauth/google/callback

# Redis Configuration (if using) - Set these in your hosting platform
REDIS_URL=your_redis_url
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Security Headers Configuration
CORS_ORIGINS=https://www.greenunimind.com,https://greenunimind.com,https://green-uni-mind.pages.dev
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400
CORS_PREFLIGHT_CONTINUE=false
CORS_OPTIONS_SUCCESS_STATUS=200
